# ReXGlue is its own git repository (branch vita-arm32).
/rexglue/

# Proprietary game data and everything derived from it: never commit.
/storm2/game/
/storm2/generated/
/storm2/generated_prev/
/storm2/image_dump/
/storm2/out/
/storm2/captures/

# Build trees and packages.
/vita/*/build-*/
/dist/

# Large or derived logs (kept locally).
/docs/logs/D3_codegen_trace*.log
/docs/logs/*_detail.log

# Generated benchmark variants (vita/bench/tools/make_variants.py).
/vita/bench/gen/

# Python bytecode caches.
__pycache__/
# Vita copy of the generated code (storm2/vita/storm2_vita_manifest.toml).
/storm2/vita/generated/
# Shader microcode dumped from the game by --null_gpu_dump_shaders (derived from the game).
/storm2/shader_dump/
# Frames rendered by the GLES backend on the PC (derived from the game).
/storm2/gles_frames/
